# Names only. Never put real values in this file (TDD Appendix C).
# Copy to apps/web/.env.local for local development.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=
# "index" only on production; every other environment stays noindex.
ROBOTS_MODE=noindex

# Supabase (added with the data layer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Background service only. Never in the web app.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_URL_DIRECT=

# Analytics (consent-gated)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
